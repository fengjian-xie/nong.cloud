    "/farm-activities": { "name": "Activity", "fields": { "id": "string", "plotId": "string", "plotName": "string", "operation": "string", "occurredAt": "instant", "source": "string", "note": "string", "createdAt": "instant" } },
    "/service-requests": { "name": "ServiceRequest", "fields": { "id": "string", "operation": "string", "plotId": "string", "plotName": "string", "standardId": "string?", "scheduledDate": "date", "standardText": "string", "status": "string", "version": "integer", "createdAt": "instant", "cancellationNote": "string?", "cancelledAt": "instant?", "availableActions": "array" }, "statuses": ["open", "claimed", "cancelled"] },
