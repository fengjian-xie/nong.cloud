page { min-height: 100%; color: #1d2924; background: #f4f7f5; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; }
button { font-size: 28rpx; }
button::after { border: 0; }
.page { min-height: 100vh; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.hero { padding: 40rpx 32rpx 34rpx; color: white; background: #087944; }
.hero-title { font-size: 42rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-copy { margin-top: 14rpx; color: rgba(255,255,255,.78); font-size: 25rpx; line-height: 1.6; }
.section { margin: 20rpx 24rpx; padding: 28rpx; border: 1rpx solid #dce4df; border-radius: 18rpx; background: white; }
.section-title { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22rpx; }
.section-title text:first-child { font-size: 31rpx; font-weight: 700; }
.section-link { color: #087944; font-size: 24rpx; }
.primary { min-height: 84rpx; display: flex; align-items: center; justify-content: center; color: white; border-radius: 14rpx; background: #087944; font-weight: 600; }
.secondary { min-height: 76rpx; display: flex; align-items: center; justify-content: center; color: #087944; border: 1rpx solid #087944; border-radius: 14rpx; background: white; }
.muted { color: #6b756f; }
.status { padding: 6rpx 14rpx; display: inline-block; border-radius: 999rpx; font-size: 22rpx; }
.status.success { color: #087944; background: #e8f6ec; }.status.pending { color: #a45d00; background: #fff4dc; }.status.danger { color: #b4342a; background: #ffefed; }.status.neutral { color: #647069; background: #edf1ef; }
.empty { min-height: 360rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #849087; }
.empty-icon { width: 96rpx; height: 96rpx; margin-bottom: 18rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #edf5ef; font-size: 45rpx; }
.form-item { margin-bottom: 24rpx; }.form-label { margin-bottom: 10rpx; display: block; color: #53605a; font-size: 25rpx; }.input, .picker { min-height: 82rpx; padding: 0 24rpx; display: flex; align-items: center; border: 1rpx solid #dce4df; border-radius: 14rpx; background: #fbfcfb; }
.safe-bottom { height: calc(20rpx + env(safe-area-inset-bottom)); }
