page { background: #F4F2EA; color: #192A22; font-family: "PingFang SC", "Source Han Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif; font-size: 30rpx; line-height: 1.6; }
view, button, input, textarea { box-sizing: border-box; }
button { margin: 0; padding: 0; border: 0; font-family: inherit; font-size: 30rpx; line-height: 1.5; background: transparent; border-radius: 0; color: inherit; }
.business-view-tabs { display:flex; flex-wrap:wrap; gap:12rpx; margin:20rpx 0; }.business-view-tabs button { padding:16rpx 22rpx; min-height:88rpx; border:1rpx solid #CDD4CB; border-radius:10rpx; background:#fff; font-size:26rpx; }
button::after { border: 0; }
.page { padding: 36rpx 32rpx 48rpx; min-height: 100vh; }
.title { display: block; color: #0F3D2E; font-size: 44rpx; font-weight: 700; line-height: 1.35; margin: 8rpx 0 14rpx; }
.heading { display: block; color: #0F3D2E; font-size: 34rpx; font-weight: 650; line-height: 1.4; margin-bottom: 16rpx; }
.muted { color: #747B75; }.small { font-size: 25rpx; }.intro { margin-bottom: 28rpx; }
.surface { background: #ffffff; border-radius: 18rpx; padding: 28rpx; margin-top: 24rpx; }
.primary { background: #0F3D2E; color: #ffffff; min-height: 88rpx; padding: 18rpx 26rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-weight: 600; }
.secondary { background: #ffffff; border: 1rpx solid #B8C7BD; color: #0F3D2E; border-radius: 14rpx; min-height: 84rpx; padding: 16rpx 24rpx; margin-top: 18rpx; }
.primary[disabled], .secondary[disabled] { opacity: .48; }
.row { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 84rpx; padding: 16rpx 0; text-align: left; border-top: 1rpx solid #E6E9E3; }
.row-copy { flex: 1; min-width: 0; }.chevron { flex-shrink: 0; width: 12rpx; height: 12rpx; border-top: 2rpx solid #747B75; border-right: 2rpx solid #747B75; transform: rotate(45deg); margin-right: 8rpx; }
.note { margin: 24rpx 0 0; padding: 18rpx 22rpx; background: #FFF3D5; color: #74501B; border-radius: 12rpx; font-size: 25rpx; line-height: 1.65; }
.demo-foot { text-align: center; color: #747B75; font-size: 24rpx; padding: 28rpx 0 12rpx; }
.field { margin-bottom: 24rpx; }.label { display: block; margin-bottom: 10rpx; font-size: 28rpx; }
.input, .textarea { width: 100%; border: 1rpx solid #D7DED6; background: #ffffff; border-radius: 12rpx; padding: 16rpx 20rpx; color: #192A22; font-size: 30rpx; }
.input { height: 84rpx; }.textarea { min-height: 160rpx; }
.error { margin: 16rpx 0; color: #A13227; font-size: 27rpx; }.success { color: #0F3D2E; padding: 18rpx 0; font-size: 27rpx; }
.media { width: 100%; height: 300rpx; border-radius: 14rpx; display: block; }.gap { margin-top: 24rpx; }.empty { padding: 48rpx 12rpx; text-align: center; }
.kv { display: flex; justify-content: space-between; gap: 24rpx; padding: 18rpx 0; border-top: 1rpx solid #E6E9E3; }.kv text:last-child { text-align: right; }
.pill { display: inline-block; padding: 4rpx 14rpx; color: #0F3D2E; background: #E6EFE6; font-size: 24rpx; border-radius: 8rpx; }
.brand { display: flex; align-items: center; gap: 16rpx; margin-bottom: 30rpx; }.brand-icon { display: block; flex: 0 0 64rpx; width: 64rpx; height: 64rpx; }.brand-name { display: block; font-size: 35rpx; font-weight: 650; color: #0F3D2E; }
