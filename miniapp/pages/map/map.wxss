.map-canvas { position: relative; height: 650rpx; background: #e7f0e8; overflow: hidden; }.map-grid { position: absolute; inset: 0; opacity: .45; background-image: linear-gradient(#a8c6ae 1rpx, transparent 1rpx), linear-gradient(90deg, #a8c6ae 1rpx, transparent 1rpx); background-size: 60rpx 60rpx; transform: rotate(-8deg) scale(1.2); }.map-pin { position: absolute; width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; color: white; border: 6rpx solid rgba(255,255,255,.9); border-radius: 50% 50% 50% 0; background: #087944; transform: rotate(-45deg); box-shadow: 0 8rpx 16rpx rgba(5,70,43,.24); }.map-pin.p1 { left: 25%; top: 28%; }.map-pin.p2 { right: 22%; top: 44%; }.map-pin.p3 { left: 47%; bottom: 22%; }.map-pin { font-size: 0; }.map-note { position: absolute; left: 24rpx; right: 24rpx; bottom: 22rpx; padding: 20rpx; border-radius: 14rpx; background: rgba(255,255,255,.93); font-weight: 600; }.map-note text { display: block; margin-top: 5rpx; color: #657069; font-size: 21rpx; font-weight: 400; }.map-resource { padding: 22rpx 0; display: flex; align-items: center; gap: 18rpx; border-top: 1rpx solid #e5ebe7; }.map-resource > view:first-child { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; color: #087944; border-radius: 50%; background: #e8f6ec; }.map-resource > view:nth-child(2) { flex: 1; }.map-resource strong, .map-resource text { display: block; }.map-resource > view text { margin-top: 7rpx; color: #657069; font-size: 22rpx; }.map-resource > text { color: #087944; font-size: 22rpx; }
