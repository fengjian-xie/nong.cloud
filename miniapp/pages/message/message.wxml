<view class="page message-page"><view class="section message-list"><view class="section-title"><text>消息中心</text><text class="muted">服务状态与系统通知</text></view><view class="message-row {{item.read ? '' : 'unread'}}" wx:for="{{messages}}" wx:key="id" data-id="{{item.id}}" bindtap="read"><i wx:if="{{!item.read}}" /><view><strong>{{item.title}}</strong><text>{{item.content}}</text><small>{{item.time}}</small></view></view></view></view>
