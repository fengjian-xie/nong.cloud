.message-actions { display: flex; justify-content: space-between; align-items: center; margin-top: 24rpx; }.message-actions button { color: #0F3D2E; padding: 12rpx 0; }.message-tabs { white-space: nowrap; }.tab-line { display: flex; gap: 30rpx; }.message-tabs button { padding: 16rpx 0; color: #747B75; font-size: 27rpx; flex-shrink: 0; }.message-tabs .active { color: #0F3D2E; border-bottom: 4rpx solid #0F3D2E; }.message-row { align-items: flex-start; }.message-head { display: flex; gap: 12rpx; align-items: baseline; color: #0F3D2E; font-weight: 600; }.unread-dot { width: 12rpx; height: 12rpx; background: #3E9B5F; border-radius: 50%; flex-shrink: 0; }.message-summary { margin: 10rpx 0; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
