.message-list { margin-top: 22rpx; padding-top: 10rpx; }.message-row { position: relative; padding: 26rpx 6rpx 26rpx 20rpx; border-top: 1rpx solid #e5ebe7; }.message-row i { position: absolute; left: 0; top: 34rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: #e88b17; }.message-row strong, .message-row text, .message-row small { display: block; }.message-row strong { font-size: 28rpx; }.message-row text { margin-top: 9rpx; color: #5e6962; font-size: 23rpx; line-height: 1.6; }.message-row small { margin-top: 10rpx; color: #939b96; font-size: 20rpx; }.message-row:not(.unread) strong { color: #657069; font-weight: 500; }
