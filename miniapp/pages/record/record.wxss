.record-head { padding: 34rpx 28rpx; display: flex; align-items: center; justify-content: space-between; color: white; background: #087944; }.record-head strong, .record-head text { display: block; }.record-head strong { font-size: 38rpx; }.record-head text { margin-top: 8rpx; color: rgba(255,255,255,.7); font-size: 23rpx; }.record-head button { margin: 0; padding: 0 22rpx; color: #087944; background: white; font-size: 23rpx; }.sync-bar { margin: 20rpx 24rpx; padding: 20rpx 24rpx; display: flex; justify-content: space-between; align-items: center; color: #075a38; border: 1rpx solid #c9dfce; border-radius: 16rpx; background: #eef8f0; }.sync-bar button { margin: 0; color: #087944; border: 1rpx solid #087944; background: white; font-size: 22rpx; }.record-list { padding-top: 4rpx; }.record-row { padding: 24rpx 0; display: flex; gap: 18rpx; align-items: flex-start; border-bottom: 1rpx solid #e5ebe7; }.record-row:last-child { border-bottom: 0; }.record-icon { width: 66rpx; height: 66rpx; display: flex; justify-content: center; align-items: center; color: #087944; border-radius: 14rpx; background: #e8f6ec; }.record-row > view:nth-child(2) { flex: 1; }.record-row strong, .record-row text, .record-row small { display: block; }.record-row text { margin-top: 8rpx; color: #53605a; font-size: 23rpx; }.record-row small { margin-top: 7rpx; color: #88918c; font-size: 20rpx; }
.family-help { margin: 20rpx 24rpx 0; padding: 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #5f3d00; border: 1rpx solid #edd39d; border-radius: 16rpx; background: #fff8e7; }.family-help strong, .family-help text { display: block; }.family-help strong { font-size: 29rpx; }.family-help text { margin-top: 7rpx; font-size: 21rpx; }.family-help button { margin: 0; flex: 0 0 auto; color: white; border-radius: 12rpx; background: #d77b0f; font-size: 23rpx; }.remote-switch { margin-bottom: 24rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 14rpx; background: #eef8f0; }.remote-switch strong, .remote-switch text { display: block; }.remote-switch strong { font-size: 28rpx; }.remote-switch text { margin-top: 5rpx; color: #637069; font-size: 21rpx; }
