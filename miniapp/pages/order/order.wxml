<view class="page order-page" wx:if="{{order}}">
  <view class="section order-summary"><view class="summary-line"><view class="round-icon">☷</view><view><text class="muted">工单编号　{{order.id}}</text><strong>{{order.title}}</strong><text>地块　{{order.plot}}</text><text>作物　{{order.crop}}</text></view><text class="status pending">{{order.status}}</text></view></view>
  <view class="section"><view class="section-title"><text>市场接单与验收</text></view><view class="timeline"><view class="timeline-item done"><i>✓</i><view><strong>需求公开</strong><text>已进入服务市场</text></view></view><view class="timeline-item {{order.provider !== '待服务商接单' ? 'done' : 'active'}}"><i>●</i><view><strong>自由接单</strong><text>{{order.provider}}</text></view></view><view class="timeline-item {{order.status === '作业中' || order.completionRate === 100 ? 'active' : ''}}"><i>○</i><view><strong>履约进度</strong><text>{{order.completionRate || 0}}% · {{order.status}}</text></view></view><view class="timeline-item {{order.status === '待标准验收' || order.status === '已完成' ? 'active' : ''}}"><i>○</i><view><strong>标准验收</strong><text>{{order.standard || '按预设服务标准核验'}}</text></view></view><view class="timeline-item {{order.status === '已完成' ? 'done' : ''}}"><i>○</i><view><strong>系统与用户评分</strong><text>系统完成率评分 {{order.systemScore || '待生成'}} · 用户评分 {{order.customerScore || '待评价'}}</text></view></view></view></view>
  <view class="section service-info"><view class="section-title"><text>服务信息</text></view><view><text>服务方</text><strong>{{order.provider}}</strong></view><view><text>计划时间</text><strong>{{order.schedule}}</strong></view><view><text>验收标准</text><strong>{{order.standard || '预设服务标准'}}</strong></view><view><text>完成率</text><strong>{{order.completionRate || 0}}%</strong></view></view>
  <view class="order-actions" wx:if="{{order.action !== 'none'}}"><button class="primary" loading="{{submitting}}" bindtap="act">{{order.action === 'checkin' ? '按标准开始作业' : order.action === 'fulfill' ? '提交标准验收' : order.action === 'accept' ? '确认标准验收' : '提交用户评分'}}</button></view>
</view>
