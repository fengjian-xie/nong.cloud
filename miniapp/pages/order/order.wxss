.order-summary { margin-top: 22rpx; }.summary-line { display: flex; gap: 20rpx; align-items: flex-start; }.round-icon { width: 78rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; color: #087944; border-radius: 50%; background: #e8f6ec; }.summary-line > view:nth-child(2) { flex: 1; }.summary-line strong, .summary-line text { display: block; }.summary-line strong { margin: 10rpx 0 16rpx; font-size: 31rpx; }.summary-line text:not(.muted) { margin-top: 8rpx; color: #53605a; font-size: 23rpx; }.timeline-item { position: relative; min-height: 92rpx; display: flex; gap: 22rpx; color: #9da59f; }.timeline-item::after { content: ''; position: absolute; left: 15rpx; top: 32rpx; bottom: 0; width: 2rpx; background: #dce4df; }.timeline-item:last-child::after { display: none; }.timeline-item i { width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; z-index: 1; border-radius: 50%; background: white; font-style: normal; }.timeline-item.done, .timeline-item.active { color: #087944; }.timeline-item.done i { color: white; background: #087944; }.timeline-item strong, .timeline-item text { display: block; }.timeline-item text { margin-top: 7rpx; color: #7b857f; font-size: 22rpx; }.service-info > view:not(.section-title) { padding: 14rpx 0; display: flex; justify-content: space-between; color: #657069; font-size: 24rpx; }.service-info strong { color: #25332b; font-weight: 500; }.order-actions { position: sticky; bottom: 0; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); border-top: 1rpx solid #dce4df; }
