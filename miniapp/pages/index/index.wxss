.home-page { background: #f4f7f5; }
.home-hero { padding: calc(92rpx + env(safe-area-inset-top)) 38rpx 54rpx; color: white; background: #087944; }
.hero-main { font-size: 44rpx; font-weight: 700; }.hero-slogan { margin-top: 45rpx; font-size: 31rpx; }.hero-sub { margin-top: 9rpx; color: rgba(255,255,255,.76); font-size: 24rpx; }
.home-loading { padding: 120rpx 0; color: #6b756f; text-align: center; }
.location-row { margin: -18rpx 24rpx 0; min-height: 92rpx; padding: 0 26rpx; display: flex; align-items: center; gap: 14rpx; border: 1rpx solid #dce4df; border-radius: 18rpx 18rpx 0 0; background: white; box-shadow: 0 8rpx 24rpx rgba(24,65,43,.06); }.pin { color: #087944; }.location-action { margin-left: auto; color: #53605a; font-size: 24rpx; }
.open-section { margin-top: 0; border-radius: 0 0 18rpx 18rpx; }
.resource-grid { display: grid; grid-template-columns: repeat(3, 1fr); }.resource { display: flex; flex-direction: column; align-items: center; gap: 6rpx; font-size: 24rpx; }.resource-icon { font-size: 45rpx; }.resource .muted { font-size: 21rpx; }
.divider { height: 1rpx; margin: 28rpx 0; background: #e5ebe7; }.service-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6rpx; }.service-shortcut { display: flex; flex-direction: column; align-items: center; gap: 10rpx; font-size: 21rpx; text-align: center; }.service-symbol { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; color: #087944; border-radius: 50%; background: #eaf5eb; font-size: 32rpx; }
.reminder, .sync-notice { margin: 20rpx 24rpx; padding: 26rpx; display: flex; align-items: center; gap: 20rpx; border-radius: 18rpx; }.reminder { color: #614200; border: 1rpx solid #f2d99a; background: #fff8e8; }.sync-notice { color: #075a38; border: 1rpx solid #c9dfce; background: #eef8f0; }
.reminder view, .sync-notice view { flex: 1; }.reminder strong, .reminder text, .reminder small, .sync-notice strong, .sync-notice text { display: block; }.reminder strong, .sync-notice strong { margin-bottom: 8rpx; }.reminder text, .sync-notice text { font-size: 24rpx; }.reminder small { margin-top: 7rpx; color: #7c735d; font-size: 21rpx; }.notice-icon { color: #e89a1a; }.cloud-icon { font-size: 40rpx; }.sync-button { padding: 8rpx 14rpx; border: 1rpx solid #087944; border-radius: 10rpx; font-size: 22rpx !important; }
