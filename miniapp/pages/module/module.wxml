<view class="page"><block wx:if="{{definition}}"><text class="small muted">{{context ? context.identity.org : '公开准入说明'}}</text><text class="title">{{definition.title}}</text><view class="intro muted">{{definition.summary}}</view><view class="note">{{definition.caution}}</view>
 <view wx:if="{{variants.length > 1}}" class="business-view-tabs"><button wx:for="{{variants}}" wx:key="id" data-id="{{item.id}}" bindtap="variant" class="{{definition.id === item.id ? 'active-filter' : ''}}">{{item.title}}</button></view>
 <block wx:if="{{view === 'overview'}}">
 <view class="surface"><text class="heading">执行与验收参考</text><view wx:for="{{steps}}" wx:key="*this" class="step"><text class="step-number">{{index + 1}}</text><text>{{item}}</text></view></view>
 <block wx:if="{{definition.id === 'costs'}}"><view class="surface"><text class="heading">种植成本估算</text><view class="small muted intro">以下为人工输入的本地估算，尚未接入当地行情。家庭劳动与实际支出分开。</view>
 <view class="field"><text class="label">确认出工人天（人数 × 天数）</text><input class="input" type="digit" data-field="laborDays" value="{{laborDays}}" bindinput="costEdit" placeholder="不是按键次数"/></view>
 <view class="field"><text class="label">当地人工参考价（元/天）</text><input class="input" type="digit" data-field="dailyPrice" value="{{dailyPrice}}" bindinput="costEdit" placeholder="请输入经确认的行情"/></view>
 <view class="field"><text class="label">实际施用农资成本（元）</text><input class="input" type="digit" data-field="materials" value="{{materials}}" bindinput="costEdit"/></view>
 <view class="field"><text class="label">其他现金成本（元）</text><input class="input" type="digit" data-field="other" value="{{other}}" bindinput="costEdit"/></view>
 <view class="field"><text class="label">预计产量（公斤）</text><input class="input" type="digit" data-field="yieldKg" value="{{yieldKg}}" bindinput="costEdit"/></view>
 <view class="field"><text class="label">参考加价比例（%）</text><input class="input" type="digit" data-field="markup" value="{{markup}}" bindinput="costEdit"/></view><button class="primary" bindtap="calculate">估算参考价</button>
 <view wx:if="{{costResult}}" class="gap"><view class="kv"><text>现金成本</text><text>{{costResult.cash}}元</text></view><view class="kv"><text>完整成本</text><text>{{costResult.complete}}元</text></view><view class="kv"><text>完整单位成本</text><text>{{costResult.unit}}元/公斤</text></view><view class="kv"><text>加价后参考价</text><text>{{costResult.reference}}元/公斤</text></view><view class="note">尚未包含未输入的租金、折旧、税费等；不是最低成本或保底收购价。正式版需完整成本科目和行情来源。</view></view></view></block>
 <view class="surface"><view class="list-toolbar"><button class="{{filter === 'all' ? 'active-filter' : ''}}" data-id="all" bindtap="filter">全部</button><button class="{{filter === 'draft' ? 'active-filter' : ''}}" data-id="draft" bindtap="filter">本地草稿（{{draftCount}}）</button></view>
 <button wx:if="{{filter === 'all'}}" class="row" bindtap="toggleDetail"><view class="row-copy"><text>{{definition.title}}示例详情</text><view class="small muted">交互样例，非真实业务</view></view><view class="chevron"/></button>
 <block wx:if="{{detail && filter === 'all'}}"><view wx:for="{{sample}}" wx:key="label" class="kv"><text>{{item.label}}</text><text class="muted">{{item.value}}</text></view><button wx:if="{{definition.id === 'services' && (context.identity.role === 'machine' || context.identity.role === 'team' || context.identity.role === 'protection')}}" class="secondary" bindtap="advance">推进演示服务状态</button></block>
 <view wx:for="{{drafts}}" wx:key="id" class="gap"><text class="pill">{{item.status}}</text><view class="small muted">{{item.org}}</view><view wx:for="{{item.values}}" wx:key="label" wx:for-item="field" class="kv"><text>{{field.label}}</text><text>{{field.value}}</text></view></view>
 <view wx:if="{{filter === 'draft' && !draftCount}}" class="empty muted">当前身份暂无本地草稿。</view></view>
 <button wx:if="{{fields.length}}" class="primary gap" bindtap="form">{{definition.id === 'application' ? '填写申请草稿' : '新增本地演示草稿'}}</button>
 </block><block wx:else><view class="surface"><text class="heading">{{definition.id === 'application' ? '添加角色申请' : '本地草稿'}}</text>
 <block wx:if="{{definition.id === 'application'}}">
 <view class="field"><text class="label">申请角色</text><picker range="{{applicationRoleNames}}" value="{{applicationRoleIndex < 0 ? 0 : applicationRoleIndex}}" bindchange="roleChange"><view class="input picker-value"><text>{{applicationRoleIndex < 0 ? '请选择角色' : applicationRoleNames[applicationRoleIndex]}}</text><view class="chevron"/></view></picker></view>
 <view class="field"><text class="label">所在地址 · 省 / 市 / 区县</text><picker mode="region" value="{{region}}" bindchange="regionChange"><view class="region-columns"><view class="input">{{regionChosen ? region[0] : '请选择省'}}</view><view class="input">{{regionChosen ? region[1] : '请选择市'}}</view><view class="input">{{regionChosen ? region[2] : '请选择区县'}}</view></view></picker></view>
 <view class="field"><text class="label">乡镇 / 街道</text><picker range="{{towns}}" value="{{townIndex < 0 ? 0 : townIndex}}" disabled="{{!regionChosen || !towns.length}}" bindchange="townChange"><view class="input picker-value"><text>{{townIndex < 0 ? '请选择乡镇 / 街道' : towns[townIndex]}}</text><view class="chevron"/></view></picker><view class="small muted">{{!regionChosen ? '请先选择省、市、区县' : !towns.length ? '此区县乡镇数据待接入，暂不能保存申请；不使用其他区县的乡镇代替。' : '切换区县后需重新选择乡镇。'}}</view></view>
 <view class="field"><text class="label">详细地址</text><input class="input" value="{{detailAddress}}" bindinput="detailAddressChange" placeholder="村/社区、道路、门牌等（仅测试信息）"/></view>
 <view class="note">省市区县使用微信原生地区选择。原型先接入福安市乡镇/街道；其他区县的乡镇库后续扩展。申请不等于已获授权。</view>
 </block>
 <view wx:for="{{fields}}" wx:key="label" class="field"><text class="label">{{item.label}}</text><input class="input" value="{{item.value}}" data-index="{{index}}" bindinput="edit" placeholder="仅填写测试信息"/></view><view class="note">真实附件上传、签署和接口待接入。照片/视频未上传时不能宣称已具备验收证据。</view><button class="primary gap" bindtap="save">保存本地草稿</button><button class="secondary" bindtap="overview">返回业务概览</button></view></block>
 <view wx:if="{{notice}}" class="success">{{notice}}</view></block><view wx:else class="empty"><text class="title">没有可用权限</text><button class="primary" bindtap="back">返回工作台</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="demo-foot">演示 · 不提交真实资料、不形成合同或支付</view></view>
