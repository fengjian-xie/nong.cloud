.error{background:#ffede8;color:#8f3427;padding:24rpx;border-radius:16rpx;word-break:break-all}.notice{padding:24rpx;background:#e6eee5;border-radius:16rpx;line-height:1.7}.surface textarea{min-height:140rpx}.surface input,.surface textarea{box-sizing:border-box;width:100%}.heading{display:block}.pill{display:inline-block}.surface{word-break:break-word}
.page button{display:block;width:100%;min-height:80rpx;padding:16rpx 22rpx;border:1rpx solid #CDD4CB;border-radius:12rpx;background:#fff;color:#0F3D2E;text-align:center}.page button.primary{background:#0F3D2E;color:#fff;border-color:#0F3D2E}.page button[disabled]{opacity:.45}
