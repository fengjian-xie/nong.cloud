<view class="page">
 <text class="title">乡桥数据库工作台</text><view class="notice small">真实本地接口联调。支付、摄像头、合同、硬件验签尚未接通；不展示演示数据作为实际成果。</view>
 <block wx:if="{{context}}"><text class="heading gap">{{context.account.name}}</text><view class="small muted">{{context.identity.centerName}} · {{context.identity.org}}</view><identity-switcher context="{{context}}" bindchange="switchChanged"/>
 <picker class="gap" range="{{moduleTitles}}" value="{{moduleIndex}}" bindchange="moduleChanged" disabled="{{busy}}"><view class="input">{{active ? active.title : '请选择已接通模块'}} <view class="chevron"/></view></picker>
 <view wx:if="{{guidance}}" class="surface"><text class="heading">{{guidance.title}}</text><view wx:for="{{guidance.fees}}" wx:key="label" class="gap"><text class="small">{{item.label}}：{{item.amountText}}元</text><view class="small muted">{{item.note}}</view></view><button class="gap" bindtap="toggleGuide">{{guideExpanded ? '收起办事指引' : '查看办理与验收指引'}}</button><block wx:if="{{guideExpanded}}"><view wx:for="{{guidance.steps}}" wx:key="module" class="gap"><text class="small">{{item.title}}</text><view class="small muted">{{item.detail}}</view></view><text class="heading gap">核对要点</text><view wx:for="{{guidance.checks}}" wx:key="*this" class="small gap">{{item}}</view><view wx:for="{{guidance.limits}}" wx:key="*this" class="small muted gap">{{item}}</view></block></view>
 <view wx:if="{{guidanceError}}" class="small muted gap">{{guidanceError}}</view>
 <view wx:if="{{error}}" class="error gap">{{error}}</view><view wx:if="{{notice}}" class="notice gap">{{notice}}</view>
 <view wx:if="{{canCreate}}" class="surface"><text class="heading">新增{{active.title}}</text>
  <block wx:for="{{fields}}" wx:key="id"><view wx:if="{{item.id !== 'oldCardId' || form.kind === 'replacement'}}" class="gap"><text class="small">{{item.label}}</text>
   <block wx:if="{{item.isAddress}}"><picker mode="region" value="{{region}}" bindchange="regionChange"><view class="input">{{regionChosen ? region[0] + ' / ' + region[1] + ' / ' + region[2] : '请选择省 / 市 / 区县'}}</view></picker><picker class="gap" range="{{towns}}" value="{{townIndex}}" disabled="{{!regionChosen || !towns.length}}" bindchange="townChange"><view class="input">{{townIndex >= 0 ? towns[townIndex] : '请选择乡镇 / 街道'}}</view></picker><input class="input gap" placeholder="村、门牌等详细地址" value="{{detailAddress}}" bindinput="detailChange"/><view wx:if="{{regionChosen &amp;&amp; !towns.length}}" class="small muted gap">该区县乡镇库尚未配置，本版仅支持福安联调；请联系中心补充。</view></block>
   <picker wx:elif="{{item.select}}" range="{{item.choiceLabels}}" value="{{item.choiceIndex}}" data-field="{{item.id}}" bindchange="choice"><view class="input">{{item.choiceLabels[item.choiceIndex]}}</view></picker>
   <textarea wx:elif="{{item.multiline}}" class="input" maxlength="2000" data-field="{{item.id}}" value="{{form[item.id] || ''}}" bindinput="edit"/>
   <input wx:else class="input" data-field="{{item.id}}" value="{{form[item.id] || ''}}" bindinput="edit"/>
  </view></block><button class="primary gap" disabled="{{busy}}" bindtap="submit">提交到数据库</button>
 </view>
 <view wx:if="{{active &amp;&amp; (active.id === 'orders' || active.id === 'cards')}}" class="surface"><text class="small">{{active.id === 'cards' ? '挂失原因（挂失前填写）' : '执行或验收说明'}}</text><textarea class="input" value="{{actionNote}}" bindinput="note" maxlength="2000"/><view class="small muted gap">状态与版本由服务端核验，不代表设备确认或质量认证。</view></view>
 <view wx:if="{{active &amp;&amp; active.id === 'cardRequests'}}" class="notice small gap">办卡、补卡报价均100元/张，支付未接通。批准后仅登记云端卡，不代表实物已交付。补卡需先挂失原卡。</view>
 <view wx:if="{{active &amp;&amp; active.id === 'memberships'}}" class="notice small gap">身份审核与会员生效分开。免费方案审核后生效；收费方案待付款，不模拟支付成功。种植户平台会员费为0。</view>
 <view wx:if="{{active &amp;&amp; (active.id === 'memberships' || active.id === 'requests')}}" class="surface"><text class="small">撤回或取消原因</text><textarea class="input" value="{{actionNote}}" bindinput="note" maxlength="2000"/><view class="small muted gap">会员仅待审核/待付款可撤回，不等于退款。服务需求仅发起人、未接单时可取消；已接单须协商。</view></view>
 <view wx:if="{{active &amp;&amp; (active.id === 'stock' || active.id === 'trades')}}" class="notice small gap">等级和库存是卖方申报，尚未核验检测及货权凭据；请另行核对计量、等级口径、采收时间、保存条件与损耗。</view>
 <view wx:if="{{active &amp;&amp; active.id === 'trades'}}" class="surface"><text class="small">交接、验收或争议说明</text><textarea class="input" value="{{actionNote}}" bindinput="note" maxlength="2000"/><view class="small muted gap">金额为整数分，数量为千克。验收不代表付款；争议时库存保持锁定。</view></view>
 <view wx:if="{{detailsId}}" class="surface"><text class="heading">{{detailsKind === 'handovers' ? '采购交接历史' : '卡片记录与历史'}}</text><view class="small gap">{{detailsId}} · 共 {{detailTotal}} 条 · 第 {{detailPage}} 页；只读留痕，不代表付款或硬件验收。</view><view wx:for="{{detailRows}}" wx:key="id" class="gap"><text class="small">{{item.heading}}</text><view class="small muted">{{item.summary}} · {{item.at}}</view></view><view wx:if="{{!detailRows.length}}" class="small muted gap">暂无云端记录，不使用模拟成功代替。</view><button class="gap" disabled="{{busy || detailPage <= 1}}" bindtap="detailPrevious">历史上一页</button><button class="gap" disabled="{{busy || !detailHasNext}}" bindtap="detailNext">历史下一页</button></view>
 <view wx:if="{{active &amp;&amp; active.id === 'cards'}}" class="notice small gap">云端配置不等于设备已同步。上传记录不自动证明作业质量。</view>
 <view wx:if="{{cardId}}" class="surface"><text class="heading">A/B/C 配置</text><input class="input gap" maxlength="80" placeholder="A键作业" data-field="A" value="{{form.A}}" bindinput="edit"/><input class="input gap" maxlength="80" placeholder="B键作业" data-field="B" value="{{form.B}}" bindinput="edit"/><input class="input gap" maxlength="80" placeholder="C键作业" data-field="C" value="{{form.C}}" bindinput="edit"/><button class="primary gap" bindtap="saveConfiguration" disabled="{{busy}}">保存云端配置（待设备确认）</button></view>
 <view class="surface small">共 {{total}} 条 · 第 {{page}} 页 · 每页 {{pageSize}} 条<button class="gap" disabled="{{busy || page <= 1}}" bindtap="previousPage">上一页</button><button class="gap" disabled="{{busy || !hasNext}}" bindtap="nextPage">下一页</button></view>
 <view wx:for="{{rows}}" wx:key="id" class="surface"><text class="heading">{{item.heading}}</text><view class="pill gap">{{item.statusText}}</view><view class="small gap">{{item.summary}}</view><view wx:if="{{active.id === 'cards'}}" class="small gap">云端 V{{item.desiredConfigVersion}} / 设备确认 V{{item.acknowledgedConfigVersion}}<view class="gap">{{item.configurationSummary}}</view></view><view class="small muted gap">编号：{{item.id}} · 版本 {{item.version || '-'}}</view>
 <button wx:if="{{item.canWithdraw}}" class="gap" disabled="{{busy}}" data-id="{{item.id}}" bindtap="withdraw">{{active.id === 'memberships' ? '撤回申请（不等于退款）' : '取消未接单需求'}}</button>
 <button wx:if="{{item.canClaim}}" class="gap" disabled="{{busy}}" data-id="{{item.id}}" data-action="claim" bindtap="action">接单</button><button wx:if="{{item.canStart}}" class="gap" disabled="{{busy}}" data-id="{{item.id}}" data-action="check-in" bindtap="action">开工</button><button wx:if="{{item.canSubmit}}" class="gap" disabled="{{busy}}" data-id="{{item.id}}" data-action="submit" bindtap="action">提交完工</button><block wx:if="{{item.canAccept}}"><button class="gap" disabled="{{busy}}" data-id="{{item.id}}" data-action="accept" bindtap="action">验收确认</button><button class="gap" disabled="{{busy}}" data-id="{{item.id}}" data-action="dispute" bindtap="action">提出争议</button></block><button wx:if="{{item.canRead}}" class="gap" disabled="{{busy}}" data-id="{{item.id}}" data-action="read" bindtap="action">标为已读</button><button wx:if="{{item.canConfigure}}" class="gap" disabled="{{busy}}" data-id="{{item.id}}" bindtap="configure">设置按键</button></view>
 <view wx:for="{{rows}}" wx:key="id"><button wx:if="{{item.canLose}}" class="gap" disabled="{{busy}}" data-id="{{item.id}}" data-action="report-loss" bindtap="action">挂失 {{item.id}}</button><button wx:if="{{item.canCancel}}" class="gap" disabled="{{busy}}" data-id="{{item.id}}" data-action="cancel" bindtap="action">取消申请 {{item.id}}</button><view wx:if="{{active &amp;&amp; active.id === 'cards'}}" class="surface small"><text>{{item.id}} 记录查询</text><button class="gap" data-id="{{item.id}}" data-kind="events" bindtap="history" disabled="{{busy}}">采集入库记录</button><button class="gap" data-id="{{item.id}}" data-kind="configuration-history" bindtap="history" disabled="{{busy}}">按键配置历史</button><button class="gap" data-id="{{item.id}}" data-kind="binding-history" bindtap="history" disabled="{{busy}}">绑定与状态历史</button></view></view>
 <view wx:if="{{!rows.length &amp;&amp; !busy &amp;&amp; !error}}" class="empty">暂无当前身份有权访问的记录。</view><button class="gap" bindtap="refresh" disabled="{{busy}}">刷新数据库记录</button><button class="gap" bindtap="logout" disabled="{{busy}}">统一退出</button></block>
 <view wx:if="{{!context &amp;&amp; error}}" class="error gap">{{error}}</view><button wx:if="{{!context &amp;&amp; !busy}}" class="gap" bindtap="openLogin">重新登录</button>
 <view wx:if="{{active &amp;&amp; active.id === 'trades'}}" wx:for="{{rows}}" wx:key="id" class="surface"><text class="small">{{item.id}}</text><button wx:for="{{item.tradeActions}}" wx:for-item="operation" wx:key="id" class="gap" disabled="{{busy}}" data-id="{{item.id}}" data-action="{{operation.id}}" bindtap="tradeAction">{{operation.label}}</button><button class="gap" disabled="{{busy}}" data-id="{{item.id}}" bindtap="tradeHistory">交接历史</button></view>
 <view class="demo-foot">农户平台免费，办卡/补卡100元。本地联调不收款。地块、方案、批次选项暂限前100条。商户与分账仅在管理后台配置。</view>
</view>
