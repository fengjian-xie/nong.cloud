<view class="page me-page"><view class="me-hero"><view class="me-avatar">林</view><view><strong>{{user.name}}</strong><text>{{user.phone}}</text><small>福安市 · {{user.role}}</small></view></view><view class="section"><view class="section-title"><text>当前业务身份</text><text class="muted">切换后刷新业务权限</text></view><view class="identity-list"><button class="identity {{current === item.id ? 'active' : ''}}" wx:for="{{identities}}" wx:key="id" data-id="{{item.id}}" bindtap="switchRole"><view><strong>{{item.name}}</strong><text>{{item.id === 'grower' ? '地块、需求、验收与记录' : '签到、履约与服务记录'}}</text></view><text>{{current === item.id ? '当前' : '切换 ›'}}</text></button></view></view><view class="section menu-list"><view bindtap="goMessages"><text>消息中心</text><text>›</text></view><view><text>认证状态</text><text class="status success">已认证</text></view><view><text>福安一期范围</text><text>查看 ›</text></view></view><button class="logout" bindtap="logout">退出登录</button></view>
