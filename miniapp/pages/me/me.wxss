.me-hero { padding: 50rpx 34rpx; display: flex; align-items: center; gap: 24rpx; color: white; background: #087944; }.me-avatar { width: 108rpx; height: 108rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(255,255,255,.42); border-radius: 50%; background: rgba(255,255,255,.13); font-size: 42rpx; font-weight: 700; }.me-hero strong, .me-hero text, .me-hero small { display: block; }.me-hero strong { font-size: 36rpx; }.me-hero text { margin-top: 8rpx; color: rgba(255,255,255,.72); font-size: 23rpx; }.me-hero small { margin-top: 12rpx; font-size: 23rpx; }.identity { width: 100%; margin-top: 14rpx; padding: 24rpx; display: flex; justify-content: space-between; align-items: center; text-align: left; border: 1rpx solid #dce4df; border-radius: 14rpx; background: white; }.identity.active { border-color: #75b783; background: #f1f8f2; }.identity strong, .identity text { display: block; }.identity > view text { margin-top: 8rpx; color: #657069; font-size: 22rpx; }.identity > text { color: #087944; font-size: 23rpx; }.menu-list { padding-top: 4rpx; padding-bottom: 4rpx; }.menu-list > view { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #e5ebe7; }.menu-list > view:last-child { border-bottom: 0; }.logout { width: calc(100% - 48rpx); margin: 26rpx 24rpx; color: #a8372e; border: 1rpx solid #e4bbb6; border-radius: 14rpx; background: white; }
