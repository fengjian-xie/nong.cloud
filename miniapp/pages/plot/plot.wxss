.plot-tools { padding: 20rpx 24rpx; display: flex; gap: 14rpx; background: white; }.search { flex: 1; min-height: 76rpx; padding: 0 22rpx; display: flex; align-items: center; gap: 12rpx; border: 1rpx solid #dce4df; border-radius: 14rpx; background: #f7f9f8; }.search input { flex: 1; }.add { width: 188rpx; min-height: 76rpx; color: white; border-radius: 14rpx; background: #087944; font-weight: 600; }.plot-form { margin-top: 18rpx; }.plot-filter { padding: 24rpx 30rpx 10rpx; display: flex; justify-content: space-between; color: #53605a; font-size: 24rpx; }.plot-list { padding: 0 24rpx 30rpx; }.plot-card { margin-top: 16rpx; padding: 24rpx; display: flex; gap: 22rpx; border: 1rpx solid #dce4df; border-radius: 18rpx; background: white; }.plot-map { width: 116rpx; height: 116rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; color: #23864a; border-radius: 14rpx; background: #ddf0df; font-size: 50rpx; }.plot-info { flex: 1; min-width: 0; }.plot-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; }.plot-head strong { font-size: 29rpx; }.plot-info > text { margin-top: 12rpx; display: block; color: #657069; font-size: 23rpx; }.plot-info small { margin: 16rpx -24rpx -24rpx; padding: 14rpx 24rpx; display: block; color: #9e433a; background: #fff2f0; font-size: 21rpx; }
.elder-tip { margin-bottom: 20rpx; padding: 22rpx; color: #075a38; border-radius: 14rpx; background: #eef8f0; }.elder-tip strong, .elder-tip text { display: block; }.elder-tip strong { font-size: 32rpx; }.elder-tip text { margin-top: 8rpx; font-size: 24rpx; }.method-grid, .quick-actions { margin-bottom: 20rpx; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; }.method { min-height: 76rpx; color: #53605a; border: 1rpx solid #dce4df; border-radius: 13rpx; background: white; font-size: 24rpx; }.method.active { color: #075a38; border: 2rpx solid #087944; background: #eef8f0; font-weight: 700; }.quick-actions button { min-height: 90rpx; color: #075a38; border-radius: 14rpx; background: #e8f6ec; font-size: 28rpx; font-weight: 700; }.field-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.elder-input { min-height: 94rpx; font-size: 30rpx; }.location-ok { margin: -6rpx 0 20rpx; padding: 14rpx; color: #087944; border-radius: 12rpx; background: #eef8f0; font-size: 22rpx; }.elder-submit { min-height: 100rpx; font-size: 32rpx; }
