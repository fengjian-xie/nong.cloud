<view class="page plot-page">
  <view class="plot-tools"><view class="search"><text>⌕</text><input placeholder="搜索地块名称/位置" value="{{query}}" bindinput="search" /></view><button class="add" bindtap="toggleForm">{{showForm ? '取消' : '新增地块'}}</button></view>
  <view wx:if="{{showForm}}" class="section plot-form"><view class="elder-tip"><strong>不会打字也没关系</strong><text>选一种最方便的采集方式，子女也能远程帮您填写</text></view><view class="method-grid"><button class="method {{form.collectionMethod === item ? 'active' : ''}}" wx:for="{{methods}}" wx:key="*this" data-method="{{item}}" bindtap="chooseMethod">{{item}}</button></view><view class="quick-actions"><button bindtap="useLocation">◎ 自动定位</button><button bindtap="chooseMap">⌖ 地图选点</button><button bindtap="scanPhoto">▣ 拍照识别</button><button bindtap="voiceHelp">◉ 语音帮助</button></view><label class="form-item"><text class="form-label">地块名称</text><input class="input elder-input" data-field="name" value="{{form.name}}" bindinput="setField" placeholder="如：我家门口水稻田" /></label><label class="form-item"><text class="form-label">面积（亩）</text><input class="input elder-input" data-field="area" value="{{form.area}}" bindinput="setField" type="digit" placeholder="不知道可先估算" /></label><label class="form-item"><text class="form-label">所在地</text><input class="input elder-input" data-field="town" value="{{form.town}}" bindinput="setField" placeholder="乡镇、村、地名" /></label><view class="field-pair"><label class="form-item"><text class="form-label">海拔（米）</text><input class="input" data-field="altitude" value="{{form.altitude}}" bindinput="setField" type="digit" placeholder="定位自动获取" /></label><label class="form-item"><text class="form-label">作物/品种</text><input class="input" data-field="crop" value="{{form.crop}}" bindinput="setField" placeholder="可稍后填写" /></label></view><view wx:if="{{form.longitude}}" class="location-ok">已定位：{{form.longitude}}, {{form.latitude}}</view><button class="primary elder-submit" bindtap="submit">确认并提交核验</button></view>
  <view class="plot-filter"><text>全部地块 · {{plots.length}}</text><text>筛选 ▾</text></view>
  <view class="plot-list"><view class="plot-card" wx:for="{{plots}}" wx:key="id" wx:if="{{!query || item.name.indexOf(query) > -1 || item.town.indexOf(query) > -1}}"><view class="plot-map">⌖</view><view class="plot-info"><view class="plot-head"><strong>{{item.name}}</strong><text class="status {{item.tone}}">{{item.status}}</text></view><text>面积　{{item.area}}　·　海拔 {{item.altitude}}</text><text>位置　{{item.town}}</text><text>采集　{{item.collectionMethod}}</text><small wx:if="{{item.reason}}">未通过原因：{{item.reason}}</small></view></view></view>
</view>
