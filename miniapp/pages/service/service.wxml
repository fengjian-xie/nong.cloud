<view class="page service-page">
  <view class="service-top"><view><strong>农事服务</strong><text>从需求发布到履约验收</text></view><button bindtap="toggleForm">{{showForm ? '取消' : '发布需求'}}</button></view>
  <view wx:if="{{showForm}}" class="section request-form"><view class="section-title"><text>发布服务需求</text></view><label class="form-item"><text class="form-label">服务地块</text><picker range="{{plots}}" range-key="name" value="{{plotIndex}}" bindchange="changePlot"><view class="picker">{{plots[plotIndex].name || '请选择地块'}} ›</view></picker></label><label class="form-item"><text class="form-label">服务类型</text><picker range="{{services}}" value="{{serviceIndex}}" bindchange="changeService"><view class="picker">{{services[serviceIndex]}} ›</view></picker></label><label class="form-item"><text class="form-label">作业标准</text><picker range="{{standards}}" range-key="name" value="{{standardIndex}}" bindchange="changeStandard"><view class="picker">{{standards[standardIndex].name}} ›</view></picker><text class="standard-summary">{{standards[standardIndex].summary}}</text></label><label class="form-item"><text class="form-label">期望时间</text><input class="input" value="{{schedule}}" bindinput="setSchedule" /></label><button class="primary" bindtap="submit">确认发布</button></view>
  <view class="section order-section"><view class="section-title"><text>我的需求与工单</text><text class="muted">{{orders.length}}条</text></view><view wx:if="{{orders.length}}"><view class="order-row" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="openOrder"><view class="order-icon">✓</view><view class="order-main"><view><strong>{{item.title}}</strong><text class="status {{item.status === '已完成' ? 'success' : 'pending'}}">{{item.status}}</text></view><text>{{item.plot}}</text><small>{{item.provider}} · {{item.schedule}}</small></view><text>›</text></view></view><view wx:else class="empty"><view class="empty-icon">☷</view><text>还没有服务需求</text></view></view>
</view>
