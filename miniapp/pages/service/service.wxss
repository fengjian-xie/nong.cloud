.service-top { padding: 34rpx 28rpx; display: flex; justify-content: space-between; align-items: center; color: white; background: #087944; }.service-top strong, .service-top text { display: block; }.service-top strong { font-size: 38rpx; }.service-top text { margin-top: 6rpx; color: rgba(255,255,255,.7); font-size: 23rpx; }.service-top button { margin: 0; padding: 0 24rpx; min-height: 68rpx; color: #087944; border-radius: 12rpx; background: white; font-size: 24rpx; }.request-form { margin-top: 20rpx; }.order-section { padding-bottom: 4rpx; }.order-row { padding: 22rpx 0; display: flex; align-items: center; gap: 18rpx; border-top: 1rpx solid #e5ebe7; }.order-icon { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; color: #087944; border-radius: 50%; background: #e8f6ec; }.order-main { flex: 1; min-width: 0; }.order-main > view { display: flex; justify-content: space-between; gap: 12rpx; }.order-main > text, .order-main small { margin-top: 8rpx; display: block; color: #657069; font-size: 22rpx; }
.standard-summary { margin-top: 8rpx; display: block; color: #6b756f; font-size: 24rpx; line-height: 1.5; }
