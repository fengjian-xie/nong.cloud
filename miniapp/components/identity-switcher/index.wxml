<view wx:if="{{context}}">
 <button class="identity-band" bindtap="show"><text class="identity-label">{{context.identity.label}}</text><text>切换身份</text><view class="chevron"></view><text class="muted small identity-count">{{context.account.identities.length}}个已绑定身份</text></button>
 <view wx:if="{{open}}" class="sheet-mask" bindtap="close"><view class="identity-sheet" catchtap="noop">
 <view class="sheet-heading"><text class="heading">切换主体与身份</text><button bindtap="close" class="close-sheet">关闭</button></view>
 <text class="small muted">{{context.mode === 'backend' ? '无需重新登录，仅展示服务端批准的主体与身份。' : '无需重新登录，仅展示此演示账号绑定的身份。'}}</text>
 <button wx:for="{{context.account.identities}}" wx:key="id" data-id="{{item.id}}" class="row identity-option {{item.id === context.identity.id ? 'identity-current' : ''}}" bindtap="choose"><view class="row-copy"><text class="identity-label">{{item.label}}</text><view class="small muted">{{item.org}}</view></view><text class="pill" wx:if="{{item.id === context.identity.id}}">当前</text></button>
 <view class="note">{{context.mode === 'backend' ? '每次请求由服务端校验中心、主体、角色和对象权限；切换不自动扩大权限。' : '演示身份不构成真实授权。上线须服务端校验主体、角色和对象权限。'}}</view>
 </view></view>
</view>
